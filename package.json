{
  "name": "myraa",
  "productName": "MYRAA",
  "description": "MYRAA — a private 3D AI desktop companion powered by each user's own Gemini API key.",
  "author": "MYRAA",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/server.ts",
    "build:renderer": "vite build",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:electron --external:vite",
    "build": "npm run build:renderer && npm run build:server",
    "start": "node dist/server.cjs",
    "test": "node --test tests/*.cjs",
    "dist": "npm run build && electron-builder --win nsis",
    "pack:agent": "pyinstaller --noconfirm agent/myraa-agent.spec"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.546.0",
    "mmd-parser": "^1.0.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "tsx": "^4.19.0",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.21.0": true
  }
}
